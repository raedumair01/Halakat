EXPO_PUBLIC_API_URL=https://halakat-backend-pi.vercel.app
EXPO_PUBLIC_GROQ_CHAT_API_KEY=your-chat-groq-api-key
EXPO_PUBLIC_GROQ_VOICE_API_KEY=your-voice-groq-api-key
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
PORT=4000
MONGODB_URI=mongodb://localhost:27017/Halakat
JWT_SECRET=change-this-in-production
RESEND_API_KEY=your-resend-api-key
PASSWORD_RESET_FROM_EMAIL=Halakat <onboarding@resend.dev>
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-gmail-app-password

# Vercel deployment:
# Set EXPO_PUBLIC_API_URL in the mobile app to your deployed backend URL,
# for example https://your-project.vercel.app
# Add MONGODB_URI, JWT_SECRET, PASSWORD_RESET_FROM_EMAIL, and either Gmail
# or Resend email credentials in the Vercel project environment settings.
